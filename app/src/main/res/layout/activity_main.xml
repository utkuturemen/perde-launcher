<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="24dp"
            android:paddingEnd="40dp"
            android:paddingBottom="40dp">

            <!-- Top bar: clock, date, network, memory -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="HH:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="@color/text_primary"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="d MMMM EEEE"
                        android:format24Hour="d MMMM EEEE"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/net_status"
                    style="@style/Pill" />

                <TextView
                    android:id="@+id/ram_status"
                    style="@style/Pill"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <!-- Quick shortcuts (filled in code) -->
            <LinearLayout
                android:id="@+id/shortcut_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clipChildren="false"
                android:orientation="horizontal" />

            <TextView
                style="@style/SectionTitle"
                android:text="FAVORİLER" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fav_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/fav_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="Bir uygulamaya uzun basıp favorilere ekleyebilirsin."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                style="@style/SectionTitle"
                android:text="TÜM UYGULAMALAR" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/app_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
